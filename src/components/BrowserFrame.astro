---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { image, alt, eager = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-xl border border-white/10 bg-panel shadow-[0_40px_120px_-30px_var(--accent,#000)]',
    className,
  ]}
>
  <div
    class="flex h-9 items-center gap-1.5 border-b border-white/10 bg-white/[0.03] px-4"
    aria-hidden="true"
  >
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
  </div>
  <Image
    src={image}
    alt={alt}
    widths={[720, 1080, 1440, 1920]}
    sizes="(min-width: 1280px) 1100px, (min-width: 1024px) 58vw, 92vw"
    loading={eager ? 'eager' : 'lazy'}
    class="aspect-[16/10] w-full object-cover object-top"
  />
</div>
