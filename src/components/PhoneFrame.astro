---
// A phone as a technical outline: hairline body, no gloss.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  fig: string;
  caption: string;
}

const { image, alt, fig, caption } = Astro.props;
---

<figure class="step w-full max-w-[15rem]">
  <div class="rounded-[2rem] border border-line-strong p-2">
    <Image
      src={image}
      alt={alt}
      widths={[320, 480, 720]}
      sizes="240px"
      loading="lazy"
      class="block h-auto w-full rounded-[1.5rem]"
    />
  </div>
  <figcaption class="mt-3 flex gap-3 text-sm text-mute">
    <span class="label shrink-0 text-ink">Fig. {fig}</span>
    <span>{caption}</span>
  </figcaption>
</figure>
