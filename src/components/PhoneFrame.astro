---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'relative w-44 shrink-0 rounded-[2.4rem] border border-white/15 bg-black p-1.5 shadow-[0_30px_80px_-25px_var(--accent,#000)] sm:w-56',
    className,
  ]}
>
  <Image
    src={image}
    alt={alt}
    widths={[320, 480, 640]}
    sizes="(min-width: 640px) 224px, 176px"
    loading="lazy"
    class="aspect-[828/1792] w-full rounded-[2rem] object-cover object-top"
  />
  <span
    class="pointer-events-none absolute left-1/2 top-3 h-4 w-14 -translate-x-1/2 rounded-full bg-black"
    aria-hidden="true"
  ></span>
</div>
