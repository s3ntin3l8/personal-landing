---
const items = [
  {
    title: 'Self-hosted, all of it',
    body: 'Everything here runs on my own Proxmox homelab behind Traefik, with Authentik for single sign-on.',
  },
  {
    title: 'Infrastructure as code',
    body: 'Ansible and OpenTofu describe the hosts and roughly 65 compose stacks. Nothing is configured by hand twice.',
  },
  {
    title: 'Secure by default',
    body: 'Shared CI with CodeQL, gitleaks and dependency review. Container images are built for amd64 and arm64 and signed with Cosign.',
  },
  {
    title: 'Built with AI agents',
    body: 'I work with Claude Code and other agents every day, which is why Mullion exists.',
  },
];
---

<section
  class="border-t border-white/5 py-28 md:py-36"
  aria-labelledby="how-title"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-mute">
        Under the hood
      </p>
      <h2
        id="how-title"
        class="mt-4 text-balance text-4xl font-semibold tracking-tight md:text-6xl"
      >
        How I run it.
      </h2>
    </div>
    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((i) => (
        <li class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-7">
          <h3 class="text-xl font-semibold tracking-tight">{i.title}</h3>
          <p class="mt-3 leading-relaxed text-mute">{i.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
