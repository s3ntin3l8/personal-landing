---
import Figure from './Figure.astro';
import AnnotatedFigure from './AnnotatedFigure.astro';
import PhoneFrame from './PhoneFrame.astro';
import BranchGraph from './BranchGraph.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project: p, index } = Astro.props;
const n = index + 1;
const flip = index % 2 === 1;
const wide = p.extras?.filter((e) => e.kind === 'wide') ?? [];
const phones = p.extras?.filter((e) => e.kind === 'phone') ?? [];
let figNo = 1;
const nextFig = () => `${n}.${figNo++}`;

const specs: [string, string][] = [
  ['Part no.', p.part],
  ['Release', p.version],
  ['Stack', p.stack.join(' · ')],
  ['Runs on', p.runsOn],
  ['Auth', p.auth],
  ['Licence', p.license],
  ['Since', p.since],
];
---

<section
  id={p.id}
  data-plate
  class="scroll-mt-14 px-5 pb-28 pt-6 md:px-10 md:pb-40"
  aria-labelledby={`${p.id}-title`}
>
  <div class="rule-draw h-px bg-line-strong"></div>
  <div class="label mt-3 flex justify-between">
    <span>Plate {String(n).padStart(2, '0')}</span>
    <span class="hidden sm:inline">
      {p.part} · {p.name}
    </span>
    <span>{p.status}</span>
  </div>

  <header class="mt-14 grid gap-10 lg:grid-cols-12">
    <div class="step lg:col-span-7">
      <div class="flex items-end gap-5">
        <h2 id={`${p.id}-title`} class="display text-[clamp(4rem,11vw,10rem)]">
          {p.name}
        </h2>
        <img
          src={p.logo.src}
          alt=""
          width="48"
          height="48"
          class="mb-3 size-10 md:size-12"
        />
      </div>
      <p class="mt-6 max-w-2xl text-2xl font-medium leading-snug md:text-3xl">
        {p.fn}
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-mute">
        {p.summary}
      </p>
      <a class="xlink mt-4" href={p.github} target="_blank" rel="noopener">
        <span>Source on GitHub</span>
        <i class="arrow not-italic" aria-hidden="true">
          ↗
        </i>
      </a>
    </div>

    <dl
      class="step self-end text-sm lg:col-span-4 lg:col-start-9"
      aria-label={`${p.name} specifications`}
    >
      {specs.map(([k, v]) => (
        <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-t border-line py-2.5">
          <dt class="label pt-px">{k}</dt>
          <dd class="num text-[0.8125rem]">{v}</dd>
        </div>
      ))}
      <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-y border-line py-2.5">
        <dt class="label pt-px">Accent</dt>
        <dd class="num flex items-center gap-2 text-[0.8125rem]">
          <span
            class="inline-block size-3 border border-line-strong"
            style={`background:${p.accent}`}
            aria-hidden="true"
          ></span>
          {p.accent.toUpperCase()}
        </dd>
      </div>
    </dl>
  </header>

  <div class="mt-16 md:mt-24">
    {p.hero === 'graph' ? (
      <Figure
        fig={nextFig()}
        caption="Version graph, drawn as a schematic. One RAW, everything derived from it."
      >
        <BranchGraph />
      </Figure>
    ) : (
      <Figure
        fig={nextFig()}
        caption={p.hero.caption}
        image={p.hero.image}
        alt={p.hero.alt}
        eager={index === 0}
      />
    )}
  </div>

  {p.detail && (
    <div class="mt-20 md:mt-28">
      <AnnotatedFigure fig={nextFig()} detail={p.detail} flip={flip} />
    </div>
  )}

  {p.notes && (
    <ol class="mt-16 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
      {p.notes.map((note, i) => (
        <li class="step border-t border-line pt-4 pb-6">
          <span class="num text-sm text-signal">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="mt-2 block font-semibold">{note.title}</span>
          <span class="mt-1 block text-mute">{note.body}</span>
        </li>
      ))}
    </ol>
  )}

  {(wide.length > 0 || phones.length > 0) && (
    <div
      class:list={[
        'mt-20 grid items-end gap-10 md:mt-28 lg:grid-cols-12',
        flip && 'lg:[direction:rtl] lg:*:[direction:ltr]',
      ]}
    >
      {wide.length > 0 && (
        <div class:list={phones.length > 0 ? 'lg:col-span-8' : 'lg:col-span-9'}>
          {wide.map((w) => (
            <Figure
              fig={nextFig()}
              caption={w.caption}
              image={w.image}
              alt={w.alt}
              sizes="(min-width: 1024px) 66vw, 100vw"
            />
          ))}
        </div>
      )}
      {phones.length > 0 && (
        <div class="flex gap-6 lg:col-span-4">
          {phones.map((ph) => (
            <PhoneFrame
              image={ph.image}
              alt={ph.alt}
              fig={nextFig()}
              caption={ph.caption}
            />
          ))}
        </div>
      )}
    </div>
  )}
</section>
