---
// Desktop table of contents. The section in view gets an orange tick
// (src/scripts/rail.ts); without JS it is a plain list of anchors.
import { projects } from '../data/projects';

const entries = [
  ...projects.map((p) => ({ id: p.id, no: p.part.slice(-2), name: p.name })),
  { id: 'infra', no: '05', name: 'Infrastructure' },
  { id: 'operator', no: '06', name: 'Operator' },
];
---

<aside class="hidden border-r border-line lg:block" aria-label="Index">
  <nav class="sticky top-12 px-6 py-10">
    <p class="label mb-6">Index</p>
    <ol class="space-y-1">
      {entries.map((e) => (
        <li>
          <a
            href={`#${e.id}`}
            data-rail={e.id}
            class="rail-link flex min-h-9 items-center gap-3 text-sm text-mute transition-colors hover:text-ink"
          >
            <span class="rail-tick h-px w-2.5 bg-line-strong transition-all" />
            <span class="num text-xs">{e.no}</span>
            <span>{e.name}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
