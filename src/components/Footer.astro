---
// Colophon. GIT_SHA is set from the Docker build's COMMIT_SHA (see Dockerfile), Vercel previews
// provide VERCEL_GIT_COMMIT_SHA; locally it is "dev".
const built = new Date().toISOString().slice(0, 10);
const sha =
  (process.env.GIT_SHA || process.env.VERCEL_GIT_COMMIT_SHA || '').slice(
    0,
    7,
  ) || 'dev';
const year = new Date().getFullYear();
---

<footer class="border-t border-line-strong px-5 pb-10 pt-6 md:px-10">
  <div class="label flex justify-between">
    <span>Colophon</span>
    <span>S3N · {year}</span>
  </div>
  <div class="mt-10 grid gap-10 text-sm md:grid-cols-12">
    <dl class="space-y-1 md:col-span-6">
      <div class="flex gap-4">
        <dt class="label w-20 shrink-0">Type</dt>
        <dd>Archivo, IBM Plex Mono</dd>
      </div>
      <div class="flex gap-4">
        <dt class="label w-20 shrink-0">Built</dt>
        <dd class="num">
          {built} · {sha}
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="label w-20 shrink-0">Served</dt>
        <dd>Astro, nginx, from my own rack. No cookies, no tracking.</dd>
      </div>
    </dl>
    <ul class="flex flex-wrap gap-x-6 md:col-span-6 md:justify-end">
      <li>
        <a
          class="xlink"
          href="https://github.com/s3ntin3l8"
          target="_blank"
          rel="noopener"
        >
          <span>GitHub</span>
        </a>
      </li>
      <li>
        <a
          class="xlink"
          href="https://www.linkedin.com/in/bjoernhansen"
          target="_blank"
          rel="noopener"
        >
          <span>LinkedIn</span>
        </a>
      </li>
      <li>
        <a class="xlink" href="/impressum">
          <span>Impressum</span>
        </a>
      </li>
      <li>
        <a class="xlink" href="/datenschutz">
          <span>Datenschutz</span>
        </a>
      </li>
    </ul>
  </div>
  <p class="label mt-10">© {year} Björn Hansen</p>
</footer>
