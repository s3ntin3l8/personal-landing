---
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import BranchGraph from './BranchGraph.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const hasShots = p.features.every((f) => f.shot);
const shotFeatures = p.features.filter((f) => f.shot);
---

<section
  id={p.id}
  class="relative isolate overflow-clip border-t border-white/5 py-28 md:py-40"
  style={`--accent:${p.accent};--accent2:${p.accent2 ?? p.accent};`}
  aria-labelledby={`${p.id}-title`}
>
  <div class="chapter-glow" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-6">
    <header class="reveal mx-auto max-w-3xl text-center">
      <img
        src={p.logo.src}
        alt=""
        width="64"
        height="64"
        class="mx-auto size-16"
      />
      <p class="mt-6 text-sm font-medium uppercase tracking-[0.2em] text-mute">
        {p.kicker}
      </p>
      <h2
        id={`${p.id}-title`}
        class="mt-3 text-5xl font-semibold tracking-tight md:text-7xl"
      >
        <span class="accent-text">{p.name}</span>
      </h2>
      <p class="mt-6 text-balance text-2xl font-medium leading-snug text-ink md:text-4xl">
        {p.tagline}
      </p>
      <p class="mt-5 text-balance text-lg leading-relaxed text-mute">
        {p.blurb}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={p.github}
          target="_blank"
          rel="noopener"
          class="pill inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium"
        >
          View on GitHub <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul
        class="mt-6 flex flex-wrap items-center justify-center gap-2"
        aria-label="Tech stack"
      >
        {p.stack.map((s) => (
          <li class="rounded-full border border-white/10 px-3 py-1 font-mono text-xs text-mute">
            {s}
          </li>
        ))}
      </ul>
    </header>

    <div class="reveal-zoom mt-16 md:mt-24">
      {p.hero === 'graph' ? (
        <>
          <BranchGraph />
          <p class="mt-3 text-center text-xs text-mute">
            Illustration of the version graph. Real screenshots to follow.
          </p>
        </>
      ) : (
        <BrowserFrame
          image={p.hero.image}
          alt={p.hero.alt}
          eager={p.id === 'mullion'}
        />
      )}
    </div>

    {hasShots ? (
      <div
        data-walkthrough
        class="mt-28 grid gap-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
      >
        <ol class="space-y-24 lg:space-y-0">
          {p.features.map((f, i) => (
            <li
              data-feature={i}
              class:list={[
                'feature lg:flex lg:min-h-[70vh] lg:items-center',
                i === 0 && 'is-active',
              ]}
            >
              <div>
                <p class="accent-text font-mono text-sm">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-2 text-3xl font-semibold tracking-tight">
                  {f.title}
                </h3>
                <p class="mt-4 text-lg leading-relaxed text-mute">{f.body}</p>
                {f.shot && (
                  <div class="mt-8 lg:hidden">
                    <BrowserFrame image={f.shot.image} alt={f.shot.alt} />
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
        <div class="hidden lg:block">
          <div class="sticky top-1/2 -translate-y-1/2">
            <div class="shot-stack">
              {shotFeatures.map((f, i) => (
                <div data-shot class:list={['shot', i === 0 && 'is-active']}>
                  <BrowserFrame image={f.shot!.image} alt={f.shot!.alt} />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ) : (
      <ol class="mt-24 grid gap-6 md:grid-cols-3">
        {p.features.map((f, i) => (
          <li class="reveal rounded-2xl border border-white/10 bg-white/[0.03] p-7">
            <p class="accent-text font-mono text-sm">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">
              {f.title}
            </h3>
            <p class="mt-3 leading-relaxed text-mute">{f.body}</p>
          </li>
        ))}
      </ol>
    )}

    {p.phones && p.phones.length > 0 && (
      <div class="reveal mt-28">
        <p class="mb-10 text-center text-sm font-medium uppercase tracking-[0.2em] text-mute">
          {p.name} on your phone
        </p>
        <div class="flex flex-wrap items-start justify-center gap-6 md:gap-10">
          {p.phones.map((ph) => (
            <PhoneFrame image={ph.image} alt={ph.alt} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
