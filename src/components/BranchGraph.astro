---
// branchDAM's version graph as a schematic line drawing, standing in for a
// real capture (issue #1). One RAW root, derived nodes, one link awaiting review.
const ink = '#ece6d9';
const mute = '#8f887a';
const signal = '#ff4f00';

type Node = {
  x: number;
  y: number;
  w: number;
  name: string;
  meta: string;
  review?: boolean;
  root?: boolean;
};

const nodes: Node[] = [
  {
    x: 40,
    y: 262,
    w: 170,
    name: 'IMG_4721.RAW',
    meta: 'root · immutable',
    root: true,
  },
  { x: 370, y: 112, w: 180, name: 'proxy.mov', meta: 'h.264 · 1080p' },
  { x: 370, y: 262, w: 180, name: 'grade.drp', meta: 'DaVinci project' },
  {
    x: 370,
    y: 412,
    w: 180,
    name: 'IMG_4721-edit.jpg',
    meta: 'needs review · 71%',
    review: true,
  },
  {
    x: 720,
    y: 72,
    w: 190,
    name: 'timeline.fcpxml',
    meta: 'matched by manifest',
  },
  { x: 720, y: 192, w: 190, name: 'final-4k.mp4', meta: 'export · verified' },
  { x: 720, y: 332, w: 190, name: 'poster.jpg', meta: 'export · in Immich' },
  {
    x: 720,
    y: 452,
    w: 190,
    name: 'IMG_4721-web.jpg',
    meta: 'candidate link',
    review: true,
  },
];

// [from, to] by index; edges leave the right edge and enter the left edge.
const edges: [number, number][] = [
  [0, 1],
  [0, 2],
  [0, 3],
  [1, 4],
  [2, 5],
  [2, 6],
  [3, 7],
];
const H = 76;
const path = ([a, b]: [number, number]) => {
  const s = nodes[a];
  const t = nodes[b];
  const x1 = s.x + s.w;
  const y1 = s.y + H / 2;
  const x2 = t.x;
  const y2 = t.y + H / 2;
  const mx = (x1 + x2) / 2;
  return `M${x1} ${y1} H${mx} V${y2} H${x2}`;
};
---

<svg
  viewBox="0 0 960 600"
  class="block aspect-[16/10] w-full"
  role="img"
  aria-label="Schematic of a version graph: a RAW original with proxy, project, edit and export nodes derived from it; two links await review"
>
  <defs>
    <pattern id="bg-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path
        d="M40 0H0V40"
        fill="none"
        stroke={ink}
        stroke-opacity="0.05"
      ></path>
    </pattern>
  </defs>
  <rect width="960" height="600" fill="url(#bg-grid)"></rect>

  <g fill="none" stroke-width="1.25">
    {[...edges]
      .sort(
        (a, b) => Number(!!nodes[b[1]].review) - Number(!!nodes[a[1]].review),
      )
      .map((e) => {
        const review = nodes[e[1]].review;
        return (
          <path
            d={path(e)}
            stroke={review ? signal : ink}
            stroke-opacity={review ? 1 : 0.55}
            stroke-dasharray={review ? '5 5' : undefined}
          />
        );
      })}
  </g>

  <g font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="14">
    {nodes.map((nd) => (
      <g transform={`translate(${nd.x} ${nd.y})`}>
        <rect
          width={nd.w}
          height={H}
          fill="#0e0d0b"
          stroke={nd.review ? signal : ink}
          stroke-opacity={nd.review || nd.root ? 1 : 0.45}
          stroke-width={nd.root ? 2 : 1}
          stroke-dasharray={nd.review ? '5 5' : undefined}
        />
        <text x="14" y="32" fill={ink}>
          {nd.name}
        </text>
        <text x="14" y="54" fill={nd.review ? signal : mute} font-size="12">
          {nd.meta}
        </text>
      </g>
    ))}
  </g>

  <g
    font-family="'IBM Plex Mono', ui-monospace, monospace"
    font-size="11"
    fill={mute}
  >
    <text x="40" y="40">
      GEN 0
    </text>
    <text x="370" y="40">
      GEN 1
    </text>
    <text x="720" y="40">
      GEN 2
    </text>
  </g>
</svg>
