---
import { projects } from '../data/projects';
---

<section
  class="px-5 pb-24 pt-10 md:px-10 md:pb-32 md:pt-16"
  aria-labelledby="hero-title"
>
  <div class="label flex justify-between">
    <span>Catalogue · Edition {new Date().getFullYear()}</span>
    <span>Four parts, one rack</span>
  </div>

  <div class="relative mt-10 md:mt-16">
    <svg
      class="absolute right-0 top-0 hidden size-16 text-signal md:block"
      viewBox="0 0 64 64"
      aria-hidden="true"
    >
      <circle cx="32" cy="32" r="14" fill="none" stroke="currentColor"></circle>
      <path d="M32 6V58M6 32H58" stroke="currentColor"></path>
    </svg>

    <h1 id="hero-title" class="display text-[clamp(4.2rem,15vw,13rem)]">
      Software
      <br />
      for my own
      <br />
      rack<span class="text-signal">.</span>
    </h1>
  </div>

  <div class="mt-12 grid gap-10 lg:grid-cols-12">
    <p class="text-xl leading-relaxed lg:col-span-5">
      I’m Björn Hansen. I manage procurement for automotive software by day, and
      at night I build the self-hosted tools I wish existed. Four of them are
      listed below, open source and running on my own hardware.
    </p>
    <p class="text-mute lg:col-span-3 lg:col-start-10">
      Each part comes with its source, its spec, and an annotated look at how it
      works.
    </p>
  </div>

  <div class="mt-16">
    <table class="w-full border-collapse text-left">
      <caption class="label mb-3 text-left">Bill of materials</caption>
      <thead>
        <tr class="label border-y border-line-strong">
          <th scope="col" class="py-2.5 pr-4 font-normal">
            Part no.
          </th>
          <th scope="col" class="py-2.5 pr-4 font-normal">
            Name
          </th>
          <th scope="col" class="hidden py-2.5 pr-4 font-normal md:table-cell">
            Function
          </th>
          <th scope="col" class="hidden py-2.5 pr-4 font-normal md:table-cell">
            Release
          </th>
          <th scope="col" class="hidden py-2.5 pr-4 font-normal md:table-cell">
            Licence
          </th>
          <th scope="col" class="py-2.5 font-normal">
            Status
          </th>
        </tr>
      </thead>
      <tbody>
        {projects.map((p) => (
          <tr class="group border-b border-line transition-colors hover:bg-raised">
            <td class="num whitespace-nowrap py-4 pr-4 align-top text-sm text-mute md:align-middle">
              {p.part}
            </td>
            <th scope="row" class="py-4 pr-4 font-normal">
              <a
                href={`#${p.id}`}
                class="flex items-center gap-3 font-semibold"
              >
                <img
                  src={p.logo.src}
                  alt=""
                  width="20"
                  height="20"
                  class="size-5"
                />
                <span class="underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-signal">
                  {p.name}
                </span>
              </a>
              <span class="mt-1 block text-sm text-mute md:hidden">{p.fn}</span>
            </th>
            <td class="hidden py-4 pr-4 text-mute md:table-cell">{p.fn}</td>
            <td class="num hidden py-4 pr-4 text-sm md:table-cell">
              {p.version}
            </td>
            <td class="num hidden py-4 pr-4 text-sm md:table-cell">
              {p.license}
            </td>
            <td class="num py-4 align-top text-sm whitespace-nowrap md:align-middle">
              <span class="mr-2 inline-block size-1.5 bg-signal align-middle" />
              {p.status}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
