---
// Schematic of how the parts are served. Deliberately generic host names:
// this is a public page, so no internal hostnames or addresses.
import Figure from './Figure.astro';
import FeatureBento from './FeatureBento.astro';
import { projects, type Feature } from '../data/projects';

// The plate after the last project, so adding a project renumbers it.
const plate = projects.length + 1;

const ink = '#ece6d9';
const mute = '#8f887a';
const signal = '#ff4f00';

type Box = {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  t: string;
  s: string;
  hot?: boolean;
};
const boxes: Box[] = [
  { id: 'cf', x: 20, y: 200, w: 150, h: 70, t: 'Cloudflare', s: 'DNS · proxy' },
  {
    id: 'gw',
    x: 230,
    y: 200,
    w: 170,
    h: 70,
    t: 'Gateway',
    s: 'Traefik · L4 SNI',
    hot: true,
  },
  {
    id: 'dev',
    x: 470,
    y: 90,
    w: 180,
    h: 70,
    t: 'Edge · dev host',
    s: 'Traefik · TLS',
  },
  {
    id: 'app',
    x: 470,
    y: 310,
    w: 180,
    h: 70,
    t: 'Edge · app host',
    s: 'Traefik · TLS',
  },
  { id: 'mullion', x: 720, y: 40, w: 200, h: 44, t: 'S3N-01 Mullion', s: '' },
  { id: 'pocket', x: 720, y: 96, w: 200, h: 44, t: 'S3N-02 Pocket', s: '' },
  { id: 'runway', x: 720, y: 152, w: 200, h: 44, t: 'S3N-03 Runway', s: '' },
  { id: 'aerie', x: 720, y: 208, w: 200, h: 44, t: 'S3N-05 Aerie', s: '' },
  {
    id: 'branchdam',
    x: 720,
    y: 290,
    w: 200,
    h: 44,
    t: 'S3N-04 branchDAM',
    s: '',
  },
  { id: 'sso', x: 720, y: 346, w: 200, h: 44, t: 'Authentik SSO', s: '' },
  {
    id: 'site',
    x: 720,
    y: 402,
    w: 200,
    h: 44,
    t: 's3ntin3l8.de',
    s: '',
    hot: true,
  },
];
const box = (id: string) => {
  const b = boxes.find((x) => x.id === id);
  if (!b) throw new Error(`Infra: no box "${id}"`);
  return b;
};
const mid = (b: Box) => b.y + b.h / 2;
const link = ([from, to]: [string, string]) => {
  const s = box(from);
  const t = box(to);
  const x1 = s.x + s.w;
  const x2 = t.x;
  const mx = (x1 + x2) / 2;
  return `M${x1} ${mid(s)} H${mx} V${mid(t)} H${x2}`;
};
const links: [string, string][] = [
  ['cf', 'gw'],
  ['gw', 'dev'],
  ['gw', 'app'],
  ['dev', 'mullion'],
  ['dev', 'pocket'],
  ['dev', 'runway'],
  ['dev', 'aerie'],
  ['app', 'branchdam'],
  ['app', 'sso'],
  ['app', 'site'],
];
// The hop this page took: Cloudflare, the gateway, the app host, this site.
const onPathLinks = new Set(['cf>gw', 'gw>app', 'app>site']);

const notes: Feature[] = [
  {
    size: 'half',
    stat: 'Proxmox',
    title: 'Self-hosted, all of it',
    body: 'Proxmox hosts at home. A gateway passes TLS straight through to the edge that owns the name.',
  },
  {
    size: 'half',
    stat: '≈65 stacks',
    title: 'Infrastructure as code',
    body: 'Ansible and OpenTofu describe the hosts and roughly 65 compose stacks. Nothing is configured by hand twice.',
  },
  {
    size: 'half',
    stat: 'Cosign',
    title: 'Signed images',
    body: 'Shared CI with CodeQL, gitleaks and dependency review. Images for amd64 and arm64, signed with Cosign.',
  },
  {
    size: 'half',
    stat: 'Claude Code',
    title: 'Built with agents',
    body: 'I work with Claude Code and other agents every day, which is why Mullion exists.',
  },
];
---

<section
  id="infra"
  class="scroll-mt-12 px-5 pb-28 pt-6 md:px-10 md:pb-40"
  aria-labelledby="infra-title"
>
  <div class="rule-draw h-px bg-line-strong"></div>
  <div class="label mt-3 flex justify-between">
    <span>Plate {String(plate).padStart(2, '0')}</span>
    <span>Infrastructure</span>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-12">
    <h2
      id="infra-title"
      class="display step text-[clamp(3.5rem,8vw,7.5rem)] lg:col-span-7"
    >
      How it is served
    </h2>
    <p class="step self-end text-lg leading-relaxed text-mute lg:col-span-4 lg:col-start-9">
      Every part on this page runs on hardware in my house. This is the path a
      request takes, including the one that loaded this page.
    </p>
  </div>

  <div class="mt-16">
    <Figure
      fig={`${plate}.1`}
      caption="Request path, simplified. Orange: the hop this page took."
    >
      <svg
        viewBox="0 0 940 470"
        class="block w-full"
        role="img"
        aria-label="Cloudflare forwards to a gateway Traefik, which passes TLS through to two edge Traefik instances. The dev host serves Mullion, Pocket, Runway and Aerie; the app host serves branchDAM, Authentik and this website."
      >
        <g fill="none" stroke-width="1.25">
          {links.map((l) => {
            const onPath = onPathLinks.has(l.join('>'));
            return (
              <path
                d={link(l)}
                stroke={onPath ? signal : ink}
                stroke-opacity={onPath ? 1 : 0.45}
              />
            );
          })}
        </g>
        <g font-family="'IBM Plex Mono', ui-monospace, monospace">
          {boxes.map((b) => (
            <g transform={`translate(${b.x} ${b.y})`}>
              <rect
                width={b.w}
                height={b.h}
                fill="#0e0d0b"
                stroke={b.hot ? signal : ink}
                stroke-opacity={b.hot ? 1 : 0.45}
              />
              <text x="12" y={b.s ? 30 : 27} fill={ink} font-size="13">
                {b.t}
              </text>
              {b.s && (
                <text x="12" y="50" fill={mute} font-size="11">
                  {b.s}
                </text>
              )}
            </g>
          ))}
        </g>
        <g
          font-family="'IBM Plex Mono', ui-monospace, monospace"
          font-size="11"
          fill={mute}
        >
          <text x="20" y="20">
            PUBLIC
          </text>
          <text x="470" y="20">
            HOMELAB · PROXMOX
          </text>
        </g>
      </svg>
    </Figure>
  </div>

  <div class="mt-6">
    <FeatureBento features={notes} label="How it is run" />
  </div>
</section>
