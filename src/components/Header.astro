---
import { projects } from '../data/projects';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur-md">
  <nav
    class="flex h-12 items-center justify-between gap-6 px-5 md:px-10"
    aria-label="Main"
  >
    <a href="/" class="label !text-ink">
      S3N <span class="text-mute">/</span> Björn Hansen
    </a>
    <ul class="label hidden gap-6 md:flex lg:hidden">
      {projects.map((p) => (
        <li>
          <a href={`/#${p.id}`} class="hover:text-ink">
            {p.name}
          </a>
        </li>
      ))}
      <li>
        <a href="/#operator" class="hover:text-ink">
          Operator
        </a>
      </li>
    </ul>
    <a
      class="xlink !min-h-0"
      href="https://github.com/s3ntin3l8"
      target="_blank"
      rel="noopener"
    >
      <span>GitHub</span>
      <i class="arrow not-italic" aria-hidden="true">
        ↗
      </i>
    </a>
  </nav>
</header>
