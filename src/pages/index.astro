---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Plate from '../components/Plate.astro';
import Infra from '../components/Infra.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
---

<Base
  title="Björn Hansen · A catalogue of self-hosted software"
  description="Mullion, Pocket, Runway, branchDAM and Aerie: five self-hosted apps built by Björn Hansen, with specs, annotated screenshots and source on GitHub."
>
  <Header />
  <main>
    <Hero />
    {projects.map((project, i) => (
      <Plate project={project} index={i} />
    ))}
    <Infra />
    <About />
  </main>
  <Footer />
</Base>
