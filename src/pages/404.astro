---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Not found · Björn Hansen" description="Page not found" noindex>
  <Header />
  <main class="mx-auto flex min-h-svh max-w-2xl flex-col items-start justify-center px-6">
    <p class="font-mono text-sm text-mute">404</p>
    <h1 class="mt-3 text-5xl font-semibold tracking-tight">Nothing here.</h1>
    <a href="/" class="pill mt-8 rounded-full px-5 py-2.5 text-sm font-medium">
      Back to the start
    </a>
  </main>
  <Footer />
</Base>
