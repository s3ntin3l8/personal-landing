---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Impressum · Björn Hansen" description="Impressum" noindex>
  <Header />
  <main class="mx-auto max-w-2xl px-6 pb-32 pt-36">
    <h1 class="text-4xl font-semibold tracking-tight">Impressum</h1>
    <div class="mt-10 space-y-8 leading-relaxed text-mute">
      <section>
        <h2 class="text-lg font-medium text-ink">Angaben gemäß § 5 DDG</h2>
        <p class="mt-2">
          Björn Hansen
          <br />
          Hauptstr. 32b
          <br />
          85120 Hepberg
          <br />
          Deutschland
        </p>
      </section>
      <section>
        <h2 class="text-lg font-medium text-ink">Kontakt</h2>
        <p class="mt-2">
          E-Mail:
          <a class="underline" href="mailto:admin@s3ntin3l8.de">
            admin@s3ntin3l8.de
          </a>
        </p>
      </section>
      <section>
        <h2 class="text-lg font-medium text-ink">
          Haftung für Inhalte und Links
        </h2>
        <p class="mt-2">
          Dies ist eine private, nicht-kommerzielle Website. Für die Inhalte
          externer Links, etwa zu GitHub und LinkedIn, sind ausschließlich deren
          Betreiber verantwortlich.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Base>
